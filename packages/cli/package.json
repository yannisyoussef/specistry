{
  "name": "@specistry/cli",
  "version": "0.1.0-rc.3",
  "private": true,
  "description": "Specistry turns specifications and authored content into structured, searchable developer documentation.",
  "homepage": "https://github.com/yannisyoussef/specistry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannisyoussef/specistry.git"
  },
  "bugs": {
    "url": "https://github.com/yannisyoussef/specistry/issues"
  },
  "license": "BUSL-1.1",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "bin": {
    "specistry": "./dist/bin.js"
  },
  "bundleDependencies": [
    "@specistry/config",
    "@specistry/content",
    "@specistry/model",
    "@specistry/openapi",
    "@specistry/playground",
    "@specistry/quality",
    "@specistry/release",
    "@specistry/search",
    "@specistry/snippets",
    "zod"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES/Apache-2.0.txt",
    "NOTICE"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/ensure-cli-bin.mjs",
    "prepack": "node ../../scripts/refuse-direct-pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@specistry/config": "workspace:*",
    "@specistry/content": "workspace:*",
    "@specistry/model": "workspace:*",
    "@specistry/openapi": "workspace:*",
    "@specistry/playground": "workspace:*",
    "@specistry/quality": "workspace:*",
    "@specistry/release": "workspace:*",
    "@specistry/search": "workspace:*",
    "@specistry/snippets": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.4"
  }
}
