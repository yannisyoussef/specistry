{
  "name": "specra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, product-agnostic developer documentation",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:architecture && pnpm check:dependencies && pnpm check:licenses && pnpm check:secrets",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "dev": "pnpm --filter @specra/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && markdownlint-cli2 '**/*.md'",
    "pretest": "pnpm --filter @specra/cli... build",
    "pretest:coverage": "pnpm --filter @specra/cli... build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pretest:performance": "pnpm --filter @specra/cli... build",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:security": "vitest run tests/security",
    "pretypecheck": "pnpm --filter @specra/cli... build",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@specra/config": "workspace:*",
    "@specra/content": "workspace:*",
    "@specra/model": "workspace:*",
    "@specra/playground": "workspace:*",
    "@specra/release": "workspace:*",
    "@specra/search": "workspace:*",
    "@specra/snippets": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
